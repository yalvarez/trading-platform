# ============================================================
# TRADING PLATFORM - CONFIGURACION DE EJEMPLO
# Copiar este archivo a .env y rellenar con valores reales.
# NUNCA commitear el archivo .env al repositorio.
# ============================================================

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Telegram API ---
TG_API_ID=YOUR_TELEGRAM_API_ID
TG_API_HASH=YOUR_TELEGRAM_API_HASH
TG_PHONE=+1234567890

# Chat ID para pruebas (ID numerico de Telegram)
TG_TEST_CHAT_ID=YOUR_CHAT_ID

# --- Logging ---
LOG_LEVEL=INFO

# --- Ventanas de trading (formato HH:MM-HH:MM, separadas por coma) ---
TRADING_WINDOWS=00:00-23:59

DEFAULT_SL_XAUUSD_PIPS=100
DEFAULT_TP_XAUUSD_PIPS=100

# --- Entry range gate ---
# Applies to full TradePulse signals that carry an entry price range (e.g. "ENTRY PRICE: 4988-4992").
# open_group waits for price to enter [min,max] before executing (opens immediately if the price
# is already in range, aborts if the price already passed the range favorably or the wait times out).
# Gold (XAUUSD) always uses a shortened 5s wait / 100ms poll regardless of these settings, since
# it moves too fast for a longer wait to make sense.
ENTRY_WAIT_SECONDS=90
ENTRY_POLL_MS=200
# Tolerance in pips added to the range edges (e.g. price slightly above the range's high end for
# a BUY is still accepted within this tolerance).
TOLERANCE_PIPS=30
# ENTRY_BUFFER_POINTS is not currently used by any code path — left unset intentionally.

# --- Cuentas MT5 (Single-account operation for now; list structure supports multi-account) ---
# ACCOUNTS_JSON=[{"name":"Main Account","host":"mt5_acct1","port":8001,"active":true,"fixed_lot":0.01,"chat_id":1234567890}]

# --- Deduplication ---
DEDUP_TTL_SECONDS=120

# --- Trade Signal Processing ---
# Text not recognized as a signal is forwarded to this n8n webhook
N8N_INBOUND_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/inbound

# --- Trade Event Notifications (n8n webhook) ---
# Optional; if set, all trade events (opened, TP hit, etc) are POSTed here
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/trades
N8N_WEBHOOK_TOKEN=

# --- Management API (trade_orchestrator /mgmt/action endpoint) ---
# Receives trade management decisions (close_now, move_sl_be_now, etc) from external n8n/Ollama flow
# REQUIRED - service will not start without this
N8N_ACTION_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
MGMT_API_PORT=8200

# --- Trade API (external trade control) ---
# REQUIRED - service will not start without this
TRADE_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Mechanical dual-TP management (no longer configurable per-account) ---
# Position opening: one entry signal = two MT5 positions (tp1_leg + runner_leg) sharing one group_id
# TP1 leg: closes at TP1 price with BE+trailing on remainder
# Runner leg: uncapped proportional trailing, no fixed TP closing

# --- MT5 web UI (para VNC) ---
MT5_WEB_USER=CHANGE_ME
MT5_WEB_PASS=CHANGE_ME_strong_password
